# ============================================
# Dashboard Configuration
# Copy this file to .env and fill in your keys
# ============================================

# --- TrueNAS ---
TRUENAS_HOST=192.168.0.15
TRUENAS_API_KEY=your_truenas_api_key_here
# Set to https if your TrueNAS uses SSL
TRUENAS_PROTOCOL=http

# --- Weather (Open-Meteo — no API key needed) ---
# Find your coordinates at https://open-meteo.com/en/docs
WEATHER_LAT=34.0901
WEATHER_LON=-118.4065

# --- Finance (no API key needed) ---
# Mortgage rates from Freddie Mac, Treasury yields from Treasury.gov

# --- Stocks (Yahoo Finance — no API key needed) ---

# --- Crypto (CoinGecko — no API key needed) ---
# Comma-separated CoinGecko IDs: bitcoin, ethereum, solana, cardano, dogecoin, ripple
CRYPTO_COINS=bitcoin,ethereum,solana

# --- Service URLs to Monitor ---
# Format: NAME|URL (comma-separated)
MONITORED_SERVICES=Plex|http://192.168.0.15:32400,Jellyfin|http://192.168.0.15:8096,HomeAssistant|http://192.168.0.15:8123

# --- News (Kagi News — no API key needed) ---
# Category options: world, usa, tech, science, business, ai, defense, economy, cybersecurity
KAGI_NEWS_CATEGORY=world
KAGI_NEWS_LIMIT=5

# --- Nextcloud Calendar (CalDAV) ---
# Use an app password, not your main password
NEXTCLOUD_URL=https://your-nextcloud-instance.com
NEXTCLOUD_USERNAME=your_username_here
NEXTCLOUD_PASSWORD=your_app_password_here
NEXTCLOUD_CALENDAR_NAME=personal

# --- Network Hosts to Ping ---
# Format: NAME|HOST (comma-separated)
PING_HOSTS=Router|192.168.0.1,Cloudflare|1.1.1.1,Google|8.8.8.8

# --- Refresh Intervals (seconds) ---
REFRESH_WEATHER=600
REFRESH_TRUENAS=30
REFRESH_FINANCE=300
REFRESH_CRYPTO=300
REFRESH_NEWS=1800
REFRESH_CALENDAR=300
REFRESH_NETWORK=60
REFRESH_SERVICES=60

# --- Optional Sections (true/false) ---
ENABLE_STOCKS=true
ENABLE_NEWS=true
ENABLE_CALENDAR=true
ENABLE_NETWORK=true

# --- Server ---
PORT=1337
